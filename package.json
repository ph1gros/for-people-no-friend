{
  "name": "for-people-no-friend",
  "productName": "For People No Friend",
  "version": "1.7.1",
  "private": true,
  "description": "A local-first Windows AI character companion built with Electron, TypeScript, and Vite.",
  "main": "dist-electron/main/index.js",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:electron && pnpm build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json && pnpm build:preload",
    "build:preload": "vite build --config vite.preload.config.mts",
    "build:renderer": "vite build",
    "build:vtube-overlay": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-vtube-studio-spout.ps1",
    "clean": "rimraf dist dist-electron",
    "dev": "concurrently --kill-others-on-fail \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"vite build --config vite.preload.config.mts --watch\" \"wait-on tcp:127.0.0.1:5173 dist-electron/main/index.js dist-electron/preload/index.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:win": "pnpm build && electron-builder --win dir --x64",
    "start": "electron .",
    "smoke:preload": "node scripts/verify-preload.mjs",
    "smoke:sherpa-addon": "electron scripts/verify-electron-sherpa-addon.cjs",
    "smoke:sherpa-transcription": "electron scripts/verify-local-sherpa-transcription.cjs",
    "smoke:sqlite-backup": "electron scripts/verify-electron-sqlite-backup.cjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:preload && pnpm smoke:sherpa-addon && pnpm smoke:sqlite-backup"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "fflate": "0.8.3",
    "pixi.js": "8.13.1",
    "sherpa-onnx-node": "1.13.7",
    "uiohook-napi": "1.5.5",
    "untitled-pixi-live2d-engine": "1.3.5",
    "ws": "8.21.3"
  },
  "build": {
    "appId": "com.ph1gros.forpeoplenofriend",
    "asar": {
      "smartUnpack": false
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/prebuilds/win32-x64/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "afterPack": "scripts/prune-electron-package.cjs",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.ts"
    ],
    "extraResources": [
      {
        "from": "native/vtube-studio-spout/bin/FpnfVTubeStudioSpout.exe",
        "to": "native/vtube-studio-spout/bin/FpnfVTubeStudioSpout.exe"
      },
      {
        "from": "native/vtube-studio-spout/LICENSE.spout2.txt",
        "to": "native/vtube-studio-spout/LICENSE.spout2.txt"
      },
      {
        "from": "resources/voice-runtime/ireina_tts_service.py",
        "to": "voice-runtime/ireina_tts_service.py"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "executableName": "For People No Friend"
    }
  }
}
